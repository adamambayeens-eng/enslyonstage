  author = {Shiba, Dai and Mizuno, Hiroyasu and Yumoto, Akane and Shimomura, Michihiko and Kobayashi, Hiroe and Morita, Hironobu and Shimbo, Miki and Hamada, Michito and Kudo, Takashi and Shinohara, Masahiro and Asahara, Hiroshi and Shirakawa, Masaki and Takahashi, Satoru},
