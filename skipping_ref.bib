@article{mortreuxApproachingGravityContinuum2020,
  title = {Approaching {{Gravity}} as a {{Continuum Using}} the {{Rat Partial Weight-Bearing Model}}},
  author = {Mortreux, Marie and {Rosa-Caldwell}, Megan E.},
  year = 2020,
  month = oct,
  journal = {Life},
  volume = {10},
  number = {10},
  pages = {235},
